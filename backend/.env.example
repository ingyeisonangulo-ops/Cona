# ------------------------------------------------------------------
# Backend — IPS Centro Odontológico Nuevo Amanecer del Pacífico SAS
# Copie a .env y complete. Nunca versione el .env real.
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Origen exacto desde el que se sirve el frontend (se valida en peticiones
# que modifican estado). En dev con Vite: http://localhost:5173
APP_ORIGIN=http://localhost:5173

# Conexión de la APP: rol crm_app (sin superusuario, sin BYPASSRLS).
APP_DATABASE_URL=postgresql://crm_app:CAMBIAR_PASSWORD_APP@localhost:5432/crm
# Conexión de MIGRACIONES y SEED: rol dueño del esquema (en Railway: postgres).
MIGRATION_DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/crm
# Contraseña que el script de migraciones asigna al rol crm_app.
APP_DB_PASSWORD=CAMBIAR_PASSWORD_APP
# disable | require | verify-full  (Railway red privada: disable)
DB_SSL=disable
DB_POOL_MAX=10

# Secretos JWT (mínimo 32 caracteres aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_FAMILY_MAX_DAYS=30

# Solo para desarrollo en navegadores que no aceptan cookies Secure en http.
# Prohibido en producción (el servidor se niega a arrancar).
COOKIE_SECURE=true

# Bloqueo por intentos fallidos
LOCKOUT_MAX_ATTEMPTS_ACCOUNT=5
LOCKOUT_MAX_ATTEMPTS_IP=5
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=15

# Ruta al build del frontend que Express sirve en producción
FRONTEND_DIST=../frontend/dist

# Seed idempotente
SEED_ORG_NAME=IPS Centro Odontológico Nuevo Amanecer del Pacífico SAS
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Super Administrador
# Solo dev: contraseña común para los usuarios de prueba por rol (>=12).
# Si se omite, el seed genera una aleatoria y la imprime una vez.
SEED_DEV_PASSWORD=
SEED_DEV_EMAIL_DOMAIN=nuevoamanecer.test
